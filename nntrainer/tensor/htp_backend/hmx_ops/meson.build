hmx_ops_sources = [
  'hexkl_mm.cpp',
  'wh_trailer.cpp',
]

hmx_ops_headers = [
  'hexkl_mm.h',
  'wh_trailer.h',
]

foreach s : hmx_ops_sources
  nntrainer_sources += meson.current_source_dir() / s
endforeach

foreach h : hmx_ops_headers
  nntrainer_headers += meson.current_source_dir() / h
endforeach
